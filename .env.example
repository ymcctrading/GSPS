# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Market-data provider selection: "alpaca", "synthetic", or unset.
# Unset = auto: use Alpaca when its keys are present, else synthetic demo data
# (so the public chart still renders with no keys configured).
MARKET_DATA_PROVIDER=

# Real-time entitlement. The free stock feed is ~15 minutes delayed, which is a
# full candle on the 15-minute execution timeframe — so a scan holds Execute at
# Watch and says why (lib/data/latency.ts). Set to "true" only when the
# configured feed is genuinely real time; it turns that hold off.
MARKET_DATA_REALTIME=

# Alpaca (data + paper trading). Live trading keys optional.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# SnapTrade (optional — external brokerage linking is feature-flagged off without these)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Multi-provider market data (new providers)
# Binance: Public endpoint, no API key required for basic market data
# BINANCE_API_KEY= (optional, for advanced endpoints)

# Oanda: Forex/currency pairs data
OANDA_API_KEY=

# Twelve Data: Futures, stocks, indices, ETFs
TWELVE_DATA_API_KEY=

# Polygon.io: Stocks, crypto, options, forex
POLYGON_API_KEY=

# Finnhub: analyst rating on the ticker Company tab (lib/data/finnhub.ts).
# Free tier: 60 req/min, no credit card required. Price target is also
# attempted on this key but 403s free-tier (needs a paid Finnhub plan) and
# falls back to simulated. Unset = fully simulated, same as price target
# already is. Short interest, institutional ownership, capital flow, and
# margin terms have no vendor wired up regardless of this key.
FINNHUB_API_KEY=

# Secret required to invoke /api/market-scan (Vercel Cron sends it)
CRON_SECRET=

# Stripe (paid tiers — see lib/tiers.ts and lib/billing/stripe.ts). Unset =
# billing UI shows "not configured" instead of a broken checkout button.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INVESTOR_MODE_MONTHLY=
STRIPE_PRICE_INVESTOR_MODE_YEARLY=
STRIPE_PRICE_SYSTEM_MASTERY_MONTHLY=
# Origin used for Stripe redirect URLs; falls back to the request's own origin.
NEXT_PUBLIC_APP_URL=

# Global trading kill switch. Set to exactly "true" to refuse every order
# placement and position close across the app; anything else (including unset)
# leaves trading enabled, so a typo can neither halt trading nor resume it.
# Reads and market data are unaffected — see lib/trade/kill-switch.ts.
TRADING_DISABLED=

# Encryption key (32-byte base64) for broker credentials at rest
CREDENTIALS_ENCRYPTION_KEY=

# Set only while rotating CREDENTIALS_ENCRYPTION_KEY (the previous key value).
# Lets decrypt fall back to it so already-encrypted rows keep working until
# scripts/rotate-credentials-key.mjs re-encrypts them under the new key. See
# SECURITY.md.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# Error tracking (Sentry)
# Sign up at https://sentry.io — free tier includes error tracking and session replay
# Get DSNs from Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Email notifications (Resend)
# Sign up at https://resend.com — free tier: 100 emails/day
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=
