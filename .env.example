# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Market-data provider selection: "alpaca", "synthetic", or unset.
# Unset = auto: use Alpaca when its keys are present, else synthetic demo data
# (so the public chart still renders with no keys configured).
MARKET_DATA_PROVIDER=

# Real-time entitlement. The free stock feed is ~15 minutes delayed, which is a
# full candle on the 15-minute execution timeframe — so a scan holds Execute at
# Watch and says why (lib/data/latency.ts). Set to "true" only when the
# configured feed is genuinely real time; it turns that hold off.
MARKET_DATA_REALTIME=

# Alpaca (data + paper trading). Live trading keys optional.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# SnapTrade (optional — external brokerage linking is feature-flagged off without these)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Multi-provider market data (new providers)
# Binance: Public endpoint, no API key required for basic market data
# BINANCE_API_KEY= (optional, for advanced endpoints)

# Oanda: Forex/currency pairs data
OANDA_API_KEY=

# Twelve Data: Futures, stocks, indices, ETFs
TWELVE_DATA_API_KEY=

# Polygon.io: Stocks, crypto, options, forex
POLYGON_API_KEY=

# Secret required to invoke /api/market-scan (Vercel Cron sends it)
CRON_SECRET=

# Global trading kill switch. Set to exactly "true" to refuse every order
# placement and position close across the app; anything else (including unset)
# leaves trading enabled, so a typo can neither halt trading nor resume it.
# Reads and market data are unaffected — see lib/trade/kill-switch.ts.
TRADING_DISABLED=

# Encryption key (32-byte base64) for broker credentials at rest
CREDENTIALS_ENCRYPTION_KEY=

# Notifications — email, SMS, and browser push for high-confidence alerts.
# Each channel is independently feature-flagged off without its env vars; the
# settings page shows "not configured" per channel rather than assuming.

# SendGrid (email). Both required to enable.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Twilio (SMS). All three required to enable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Web Push (browser push). Generate a VAPID key pair with
# `npx web-push generate-vapid-keys`. All three required to enable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
