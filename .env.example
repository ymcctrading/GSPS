# GSPS environment configuration (Phase 0)
# Copy to .env.local and fill in as real integrations come online.

# --- Data source ---
# "mock" (default, deterministic, no keys needed) or a real vendor later.
GSPS_MARKET_DATA_PROVIDER=mock
# GSPS_MARKET_DATA_API_KEY=

# --- Brokerage / execution ---
# "paper" is the ONLY supported mode in Phase 0. Live execution is intentionally
# gated off until a licensed brokerage partner + compliance sign-off exist.
GSPS_BROKERAGE_MODE=paper

# --- Scanner cron ---
# When true, an in-process scheduler runs the mean-reversion scan after close.
# In production this should be an external scheduler (Vercel Cron / GitHub Action).
GSPS_ENABLE_IN_PROCESS_CRON=false
